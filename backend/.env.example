# Backend Environment Variables
PORT=5000
NODE_ENV=development

# JWT Authentication Configuration
JWT_SECRET=replace_with_your_strong_jwt_secret_min_32_characters_long
JWT_EXPIRES_IN=7d

# Firebase Admin SDK Configuration (for production Google Sign-In verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# LLM Advisor Configuration (Google Gemini or OpenAI)
# If configured, the Income Advisor uses the LLM to generate rich contextual responses.
# If omitted or offline, the advisor automatically and seamlessly falls back to the built-in expert engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional OpenAI alternative:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# External Job API Configuration (Sections 3 & 4)
# Supported providers: adzuna, jooble, jsearch, auto
# If omitted, system seamlessly searches legitimate live feeds (Arbeitnow, Himalayas, Remotive)
# and verified official partner onboarding programs (Swiggy, Urban Company, Amazon Flex, etc.)
JOB_API_PROVIDER=auto
JOB_API_URL=
JOB_API_KEY=
# Provider specific options (e.g. Adzuna requires APP_ID):
JOB_API_APP_ID=
