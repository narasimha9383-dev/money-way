# ==============================================================================
# MONEY WAY — UNIFIED ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# 1. Server & CORS Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=https://money-way-frontend.vercel.app

# 2. MongoDB Atlas Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.sjg61rc.mongodb.net/money_way?retryWrites=true&w=majority&appName=Cluster0

# 3. JWT Authentication Configuration
JWT_SECRET=replace_with_your_strong_jwt_secret_min_32_characters_long
JWT_EXPIRES_IN=7d

# 4. Firebase Admin SDK Configuration (Google OAuth Verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 5. AI Advisor LLM Configuration (Google Gemini / OpenAI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 6. External Real Job Feed & Aggregator APIs
JOB_API_PROVIDER=auto
JOB_API_URL=
JOB_API_KEY=
JOB_API_APP_ID=
